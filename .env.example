BOT_TOKEN=
# 留空表示公开；填写逗号分隔 Telegram 数字 ID 表示白名单
ALLOWED_USER_IDS=
TMP_DIR=./data/tmp
# 封面消息是否使用 spoiler 遮罩：true / false
SPOILER=true
# Optional OpenAI Responses-compatible title translation fallback.
# Called only when Google translation fails; no API key is required without fallback.
TITLE_TRANSLATION_BASE_URL=
TITLE_TRANSLATION_API_KEY=
TITLE_TRANSLATION_MODEL=
# Successful title translations persist beside TMP_DIR by default.
# TITLE_TRANSLATION_CACHE_DIR=./data/translations
